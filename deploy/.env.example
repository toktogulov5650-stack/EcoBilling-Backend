ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
ECOBILLING_API_PORT=8080

# Optional. Leave empty when no OpenTelemetry collector is running.
OTLP_ENDPOINT=

# Worker schedules are disabled by default. Enable only after the corresponding
# business and external-integration dependencies are configured.
WORKER_MONTHLY_BILLING_ENABLED=false
WORKER_MONTHLY_BILLING_INTERVAL=1.00:00:00
WORKER_OUTBOX_ENABLED=false
WORKER_OUTBOX_INTERVAL=00:01:00
WORKER_OUTBOX_BATCH_SIZE=100
