ARG DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0.401
ARG DOTNET_RUNTIME_IMAGE=mcr.microsoft.com/dotnet/runtime:10.0.12

FROM ${DOTNET_SDK_IMAGE} AS restore
WORKDIR /src
COPY Directory.Build.props Directory.Packages.props global.json ./
COPY src/EcoBilling.Worker/EcoBilling.Worker.csproj src/EcoBilling.Worker/
COPY src/EcoBilling.Infrastructure/EcoBilling.Infrastructure.csproj src/EcoBilling.Infrastructure/
COPY src/EcoBilling.Modules/EcoBilling.Modules.csproj src/EcoBilling.Modules/
COPY src/EcoBilling.SharedKernel/EcoBilling.SharedKernel.csproj src/EcoBilling.SharedKernel/
RUN dotnet restore src/EcoBilling.Worker/EcoBilling.Worker.csproj

FROM restore AS build
COPY src/ src/
RUN dotnet publish src/EcoBilling.Worker/EcoBilling.Worker.csproj \
    --configuration Release \
    --output /app/publish \
    --no-restore \
    /p:UseAppHost=false

FROM ${DOTNET_RUNTIME_IMAGE} AS final
WORKDIR /app
COPY --from=build --chown=$APP_UID:$APP_UID /app/publish .
ENV DOTNET_EnableDiagnostics=0
USER $APP_UID
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD kill -0 1 || exit 1
ENTRYPOINT ["dotnet", "EcoBilling.Worker.dll"]
