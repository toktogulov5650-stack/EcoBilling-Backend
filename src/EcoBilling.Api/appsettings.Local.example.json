{
  "ConnectionStrings": {
    "EcoBilling": "Host=your-neon-host;Database=neondb;Username=your-user;Password=your-password;SSL Mode=Require;Channel Binding=Require"
  },
  "DirectorProvisioning": {
    "RequestFingerprintKey": "replace-with-at-least-32-random-bytes-as-base64"
  },
  "InternalServiceAuthentication": {
    "Issuer": "https://control.ecobilling.local",
    "Audience": "ecobilling-local",
    "SigningKeys": [
      {
        "KeyId": "control-local-1",
        "PublicKeyPem": "-----BEGIN PUBLIC KEY-----\nreplace-with-local-rsa-public-key\n-----END PUBLIC KEY-----"
      }
    ]
  },
  "UserAuthentication": {
    "Issuer": "https://api.ecobilling.local",
    "Audience": "ecobilling-users-local",
    "ActiveSigningKeyId": "users-local-1",
    "SigningKeys": [
      {
        "KeyId": "users-local-1",
        "SecretBase64": "replace-with-at-least-32-random-bytes-as-base64"
      }
    ]
  }
}
